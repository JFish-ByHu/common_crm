# Environment variables for development environment
NODE_ENV=development
PORT=3000

# JWT configuration
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_EXPIRES_IN_SECONDS=604800
JWT_REFRESH_SECRET=replace_with_a_long_random_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000

# Database configuration
DATABASE_URL="your_database_url"

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
# Optional: REDIS_URL overrides host/port/password/db; use rediss:// for TLS.
# REDIS_URL=redis://127.0.0.1:6379/0
# Defaults to crm:<NODE_ENV>; keep this unique per environment.
REDIS_KEY_PREFIX=crm:development

# Email verification configuration
EMAIL_CODE_HASH_SECRET=replace_with_a_long_random_secret
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=your_email@example.com
EMAIL_SMTP_PASS=your_smtp_password
EMAIL_FROM=CRM <your_email@example.com>
